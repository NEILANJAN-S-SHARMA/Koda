# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: FastAPI backend base URL (e.g., http://localhost:8000 in local dev)
VITE_API_BASE_URL=""

# 4-Digit Email OTP Delivery (configure either Resend OR Gmail/SMTP in AI Studio Secrets)
# Option A: Resend API (recommended for transactional emails)
RESEND_API_KEY=""
OTP_FROM_EMAIL="Koda Studio <onboarding@resend.dev>"

# Option B: Gmail SMTP (requires 2FA + Google App Password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option C: Custom SMTP server
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
